# =============================================================================
# Flacron Lead Agent — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=Flacron Lead Agent
APP_PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# --- PostgreSQL 16 ---
POSTGRES_HOST=localhost
# Host port mapped by docker-compose (container still listens on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=flacron
POSTGRES_PASSWORD=flacron_dev_password
POSTGRES_DB=flacron_revenue_agent

# Prisma / NestJS connection string (local → Docker Postgres on host port 5433)
# Use 127.0.0.1 (not localhost) on Windows — Prisma can fail on IPv6 ::1
DATABASE_URL=postgresql://flacron:flacron_dev_password@127.0.0.1:5433/flacron_revenue_agent?schema=public

# Used by docker-compose backend service (host = postgres service name)
# DATABASE_URL=postgresql://flacron:flacron_dev_password@postgres:5432/flacron_revenue_agent?schema=public

# --- Redis ---
# Host 6380 → Docker Redis 7 (avoid Windows redis-server 3.x on 6379)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380

# Used by docker-compose backend service
# REDIS_URL=redis://redis:6379

# --- BullMQ ---
BULLMQ_PREFIX=flacron
BULLMQ_DEFAULT_ATTEMPTS=3

# --- Auth / JWT (replace with strong secrets in production) ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Multi-tenancy ---
TENANT_HEADER=x-tenant-id

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: choose default provider (openai | anthropic)
AI_DEFAULT_PROVIDER=openai

# --- Hunter.io (lead discovery / enrichment) ---
HUNTER_API_KEY=your-hunter-api-key

# --- Frontend (Next.js) — prefix with NEXT_PUBLIC_ for client exposure ---
NEXT_PUBLIC_APP_NAME=Flacron Lead Agent
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Email OAuth integrations ---
TOKEN_ENCRYPTION_KEY=change_me_to_a_32plus_char_encryption_secret
OAUTH_STATE_SECRET=change_me_oauth_state_hmac_secret
EMAIL_WEBHOOK_SECRET=change_me_webhook_secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback

# Optional IMAP (defaults to Gmail). Same SMTP_USER / SMTP_PASS App Password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# --- Deliverability guardrails ---
# Bounce rate > 5% or complaint rate > 0.1% triggers WorkspacePause
DELIVERABILITY_BOUNCE_RATE_THRESHOLD=0.05
DELIVERABILITY_COMPLAINT_RATE_THRESHOLD=0.001
# Optional DKIM selector for domain-check (defaults try google/default/selector1/…)
SMTP_DKIM_SELECTOR=

# --- SMTP / Gmail App Password (no OAuth required) ---
# Create at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Use your real name for free Gmail — brand From names land in Spam
SMTP_FROM_NAME=Your Name
SMTP_FROM=your-gmail@gmail.com
